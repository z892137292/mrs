# Copy to .env in a NEW directory; never reuse or overwrite the original NAS .env.
# chmod 600 .env ; generate each secret independently: openssl rand -hex 32
CONTROL_API_TOKEN=
WEB_BOOTSTRAP_TOKEN=
REWARDS_IMAGE=ghcr.io/z892137292/microsoft-rewards-custom:1.1.0-rc.4
WEB_IMAGE=ghcr.io/z892137292/microsoft-rewards-web-admin:1.1.0-rc.4
# Safe default: loopback. For LAN access set a specific NAS LAN IP, never 0.0.0.0.
WEB_BIND_IP=127.0.0.1
WEB_HOST_PORT=8088
ADMIN_PUBLIC_URL=http://localhost:8088
# HTTPS reverse proxy: set true, same HTTPS public URL, and only trust one controlled proxy.
WEB_COOKIE_SECURE=false
WEB_TRUST_PROXY=false
REWARDS_DATA_ROOT=./web-candidate-data
TZ=Asia/Shanghai
PUID=1000
PGID=1000
CRON_SCHEDULE=0 0 1 1 *
RUN_ON_START=false
MAX_RETRIES=2
RETRY_DELAY_MINUTES=10
RUN_TIMEOUT_MINUTES=360
STOP_GRACE_SECONDS=20
MAX_CONSECUTIVE_FAILED_RUNS=3
LOG_RETENTION_DAYS=14
LOG_REDACT_EMAILS=true
CONFIG_ERROR_DIAGNOSTICS=false
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,rewards,web
# Offline self-test placeholder only; no real Microsoft account in testing.
ACCOUNT_1_EMAIL=ci@example.invalid
#ACCOUNT_1_PASSWORD=
#ACCOUNT_1_PROXY_HTTP=true
#ACCOUNT_1_PROXY_URL=http://YOUR_PROXY_IP
#ACCOUNT_1_PROXY_PORT=17890
