diff --git a/src/util/RunSummary.ts b/src/util/RunSummary.ts
new file mode 100644
index 0000000..a935d07
--- /dev/null
+++ b/src/util/RunSummary.ts
@@ -0,0 +1,113 @@
+// [custom] Run summary + exit codes consumed by the Docker run wrapper (rewards-run).
+import fs from 'node:fs'
+import path from 'node:path'
+
+export const EXIT_OK = 0
+export const EXIT_FATAL = 1
+export const EXIT_ACCOUNT_FAILED = 2
+
+export const BOT_WARNING_ERROR = 'Microsoft bot-score warning detected'
+
+export interface AccountResult {
+    email: string
+    success: boolean
+    collectedPoints: number
+    error?: string
+}
+
+export type AccountStatus = 'ok' | 'failed' | 'skipped_bot_warning'
+
+export interface RunSummary {
+    finishedAt: string
+    version: string
+    exitCode: number
+    failedEmails: string[]
+    botWarningEmails: string[]
+    totalCollectedPoints: number
+    accounts: { email: string; status: AccountStatus; error?: string; collectedPoints: number }[]
+}
+
+/**
+ * Builds the summary for every configured account. Accounts without a result
+ * (e.g. their cluster worker crashed) are reported as failed so they get retried.
+ * Bot-score skips are not failures: retrying them would be counter-productive.
+ */
+export function buildRunSummary(allEmails: string[], results: AccountResult[], version: string): RunSummary {
+    const byEmail = new Map(results.map(r => [r.email.toLowerCase(), r]))
+    const accounts = allEmails.map(email => {
+        const r = byEmail.get(email.toLowerCase())
+        if (!r) return { email, status: 'failed' as const, error: 'No result reported', collectedPoints: 0 }
+        const status: AccountStatus = r.success
+            ? 'ok'
+            : r.error === BOT_WARNING_ERROR
+              ? 'skipped_bot_warning'
+              : 'failed'
+        return {
+            email,
+            status,
+            error: r.error ? redactSensitiveText(r.error) : undefined,
+            collectedPoints: r.collectedPoints ?? 0
+        }
+    })
+    const failedEmails = accounts.filter(a => a.status === 'failed').map(a => a.email)
+
+    return {
+        finishedAt: new Date().toISOString(),
+        version,
+        exitCode: failedEmails.length ? EXIT_ACCOUNT_FAILED : EXIT_OK,
+        failedEmails,
+        botWarningEmails: accounts.filter(a => a.status === 'skipped_bot_warning').map(a => a.email),
+        totalCollectedPoints: accounts.reduce((sum, a) => sum + a.collectedPoints, 0),
+        accounts
+    }
+}
+
+/** Writes the summary atomically (mode 0600) when RUN_SUMMARY_FILE is set. Never throws. */
+export function writeRunSummary(summary: RunSummary, target = process.env.RUN_SUMMARY_FILE?.trim()): void {
+    if (!target) return
+    try {
+        fs.mkdirSync(path.dirname(target), { recursive: true })
+        const tmp = `${target}.${process.pid}.tmp`
+        fs.writeFileSync(tmp, JSON.stringify(summary, null, 2), { mode: 0o600 })
+        fs.renameSync(tmp, target)
+    } catch (error) {
+        console.error(`[custom] Unable to write run summary: ${error instanceof Error ? error.message : String(error)}`)
+    }
+}
+
+/** Builds + writes the summary and returns the process exit code to use. */
+export function finalizeRun(allEmails: string[], results: AccountResult[], version: string): number {
+    const summary = buildRunSummary(allEmails, results, version)
+    writeRunSummary(summary)
+    return summary.exitCode
+}
+
+/** Persist a risk stop before browser cleanup or webhook processing can block. */
+export function markRiskPause(target = process.env.RUN_RISK_FILE): void {
+    try {
+        if (!target) throw new Error('Missing risk marker path')
+        fs.mkdirSync(path.dirname(target), { recursive: true, mode: 0o700 })
+        fs.writeFileSync(target, 'Microsoft risk warning detected\n', { mode: 0o600 })
+        fs.writeFileSync(path.join(path.dirname(target), 'STOP'), 'Microsoft risk warning; manual review required\n', {
+            mode: 0o600
+        })
+    } catch {
+        // Never turn a failed risk-stop write into a retryable account error.
+        console.error('[custom] Risk protection could not persist its marker; stopping immediately')
+        process.exit(78)
+    }
+}
+
+/** Scrub common credential formats before console/webhook dispatch or summary persistence. */
+export function redactSensitiveText(text: string): string {
+    return text
+        .replace(/((?:https?|socks[45]):\/\/)[^/@\s]+:[^/@\s]+@/gi, '$1[REDACTED]@')
+        .replace(/(https:\/\/api\.telegram\.org\/bot)[^/\s]+/gi, '$1[REDACTED]')
+        .replace(/(authorization\s*:\s*bearer\s+)[^\s";]+/gi, '$1[REDACTED]')
+        .replace(/((?:set-cookie|cookie)\s*:)\s*[^\r\n]*/gi, '$1 [REDACTED]')
+        .replace(
+            /(["']?(?:password|passwd|totp[_]?secret|access[_]?token|refresh[_]?token|api[_]?key|client[_]?secret|proxy[_]?password|sessionid|botToken)["']?\s*[:=]\s*)("[^"]*"|'[^']*'|[^\s,;}]+)/gi,
+            '$1[REDACTED]'
+        )
+        .replace(/((?:token|secret|code|password|api_key)=)[^&\s";]+/gi, '$1[REDACTED]')
+}
