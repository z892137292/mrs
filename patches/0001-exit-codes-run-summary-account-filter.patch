+// [custom] RUN_ACCOUNT_FILTER: comma-separated e-mails; when set only these accounts run.
+// Used by the Docker wrapper to retry just the accounts that failed.
+export function applyAccountFilter(accounts: Account[]): Account[] {
+    const raw = envStr('RUN_ACCOUNT_FILTER')
+    if (!raw) return accounts
+
+    const wanted = new Set(
+        raw
+            .split(',')
+            .map(e => e.trim().toLowerCase())
+            .filter(Boolean)
+    )
+    const selected = accounts.filter(a => wanted.has(a.email.toLowerCase()))
+    if (!selected.length || new Set(selected.map(a => a.email.toLowerCase())).size !== wanted.size) {
+        throw new Error('RUN_ACCOUNT_FILTER matched no configured account or contains unknown accounts.')
+    }
+    return selected
+}
