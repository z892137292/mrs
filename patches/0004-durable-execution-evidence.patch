@@ -0,0 +1,21 @@
+import { createRequire } from 'node:module'
+// Optional evidence observer. No searches, retries or authentication decisions are changed.
+export function controlEvidence(
+    email: string | null,
+    kind: string,
+    stage?: string,
+    observed?: number,
+    remaining?: number
+): void {
+    if (process.env.CONTROL_API_ENABLED !== 'true' || !process.env.MRS_RUN_ID || !email) return
+    const observer = createRequire(__filename)('/opt/mrs-admin/src/ledger.cjs') as {
+        emit: (
+            bot: { currentAccountEmail: string },
+            kind: string,
+            stage?: string,
+            observed?: number,
+            remaining?: number
+        ) => void
+    }
+    observer.emit({ currentAccountEmail: email }, kind, stage, observed, remaining)
+}
