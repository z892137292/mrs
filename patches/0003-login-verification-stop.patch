diff --git a/src/util/LoginSafety.ts b/src/util/LoginSafety.ts
new file mode 100644
--- /dev/null
+++ b/src/util/LoginSafety.ts
@@ -0,0 +1,29 @@
+import { markRiskPause } from './RunSummary'
+
+const manualReviewStates = new Set([
+    'ACCOUNT_LOCKED',
+    'ERROR_ALERT',
+    'EMAIL_VERIFICATION_INPUT',
+    'RECOVERY_EMAIL_INPUT',
+    '2FA_TOTP',
+    'LOGIN_PASSWORDLESS',
+    'PASSWORDLESS_SEND_CODE',
+    'OTP_CODE_ENTRY',
+    'PASSKEY_VIDEO',
+    'PASSKEY_ERROR',
+    'SIGN_IN_METHOD_PICKER',
+    'FOOTER_ACTION',
+    'CAPTCHA'
+])
+
+export function requiresManualLoginReview(state: string): boolean {
+    return manualReviewStates.has(state)
+}
+
+export function enforceLoginSafety(state: string): void {
+    if (process.env.REWARDS_BOT !== '1' || !requiresManualLoginReview(state)) return
+    markRiskPause()
+    console.error('[custom] Login verification or restriction requires manual review; automation paused')
+    // Exit before upstream account-error handlers can continue with another account.
+    process.exit(78)
+}
