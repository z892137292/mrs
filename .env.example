# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Rewards Custom - environment
#   cp .env.example .env && chmod 600 .env
#   .env holds credentials: never commit it, never paste it into chats or issues.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image ───────────────────────────────────────────────────────────────────
# Your GHCR image (lower-case owner). Pin a version tag or digest in production.
# Local build tag. Switch to your own ghcr.io/<lowercase-owner>/microsoft-rewards-custom:<version>
# only after GitHub Actions has successfully published it.
IMAGE=mrs-custom:1.0.3-rc1

# ── Container ───────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
# Owner of ./config ./sessions ./state ./logs ./diagnostics on the host (`id -u`, `id -g`)
PUID=1000
PGID=1000

# ── Schedule ────────────────────────────────────────────────────────────────
CRON_SCHEDULE=15 9 * * *
RUN_ON_START=false
SKIP_RANDOM_SLEEP=false
MIN_SLEEP_MINUTES=5
MAX_SLEEP_MINUTES=50

# ── Reliability ─────────────────────────────────────────────────────────────
# Extra attempts after a failed run. Retries only re-run the accounts that failed.
MAX_RETRIES=2
# Delay before retry N is N x RETRY_DELAY_MINUTES (linear back-off).
RETRY_DELAY_MINUTES=10
# Hard limit per attempt; the bot and its Chromium processes are killed afterwards.
RUN_TIMEOUT_MINUTES=360
# Seconds between SIGTERM and SIGKILL when stopping the bot.
STOP_GRACE_SECONDS=20
# Pause scheduled runs after this many consecutive failed runs (0 = never).
# Resume with: docker compose exec rewards rewards-ctl resume
MAX_CONSECUTIVE_FAILED_RUNS=3
# Pause everything when Microsoft reports Fraud_UserWarning_BotScore_UX for any account.
# Risk pause is mandatory; STOP_ON_BOT_WARNING=false has no effect.

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_RETENTION_DAYS=14
# Mask e-mail addresses (a***@example.com) in container output and ./logs.
# Password/token scrubbing remains enabled regardless; still review logs before sharing.
LOG_REDACT_EMAILS=true

# ── NAS proxy (ensure reachable from this container) ────────────────────────
# HTTP_PROXY/HTTPS_PROXY do not configure upstream Chromium/Impit account proxies.
# For EACH configured account set ACCOUNT_N_PROXY_HTTP=true,
# ACCOUNT_N_PROXY_URL=http://192.168.0.202 and ACCOUNT_N_PROXY_PORT=17890.
HTTP_PROXY=http://192.168.0.202:17890
HTTPS_PROXY=http://192.168.0.202:17890
# Do NOT bypass Bing/Microsoft routes by default: bypasses need to be justified.
NO_PROXY=localhost,127.0.0.1

# ── Original enabled worker features (verify against pinned upstream source) ──
CONFIG_WORKER_DESKTOP_SEARCH=true
CONFIG_WORKER_MOBILE_SEARCH=true
CONFIG_WORKER_DAILY_SET=true
CONFIG_WORKER_MORE_PROMOTIONS=true
CONFIG_WORKER_PUNCH_CARDS=true

# ── Upstream config overrides (optional, see upstream README for the full list)
#CONFIG_CLUSTERS=1
#CONFIG_ACCOUNT_DELAY_MIN=1min
#CONFIG_ACCOUNT_DELAY_MAX=3min
# Keep browser screenshots/HTML diagnostics off until you have reviewed privacy implications.
CONFIG_ERROR_DIAGNOSTICS=false
#CONFIG_CONTINTUE_ON_BOT_WARNING=false
#CONFIG_EXPERIMENTAL_BLOCK_MEDIA=false
#CONFIG_AUTO_SYNC=false

# ── Accounts (upstream format; any positive slot numbers) ───────────────────
#ACCOUNT_1_EMAIL=email@example.com
# Optional. Leave unset for passwordless / Authenticator-only accounts.
#ACCOUNT_1_PASSWORD=
#ACCOUNT_1_TOTP_SECRET=
#ACCOUNT_1_RECOVERY_EMAIL=
#ACCOUNT_1_GEO_LOCALE=auto
#ACCOUNT_1_LANG_CODE=en
#ACCOUNT_1_PROXY_HTTP=false
#ACCOUNT_1_PROXY_URL=
#ACCOUNT_1_PROXY_PORT=0
#ACCOUNT_1_PROXY_USERNAME=
#ACCOUNT_1_PROXY_PASSWORD=
#ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=false
#ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=false

#ACCOUNT_2_EMAIL=
#ACCOUNT_2_PASSWORD=
